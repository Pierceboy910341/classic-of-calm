# /etc/classic-of-calm/env  (root:root, chmod 600) — written by install.sh.
# systemd reads this file: one KEY=value per line, NO comments after values.
# After editing: sudo systemctl restart coc-streamer
#
# ---- Secrets ----
YOUTUBE_STREAM_KEY=
KAGGLE_USERNAME=
# Set ONE of these (never leave an empty KAGGLE_KEY= line, it breaks token auth):
# legacy key from kaggle.json, or a new-style API token (KGAT_...)
#KAGGLE_KEY=
#KAGGLE_API_TOKEN=
# Kaggle notebook "02 Assemble" as owner/slug
#KAGGLE_NOTEBOOK=username/02-assemble
#
# ---- Stream ----
# rtmp, or rtmps (encrypted, port 443)
STREAM_PROTOCOL=rtmp
# Full URL override, e.g. YouTube backup ingest (normally leave unset)
#STREAM_URL=
AUDIO_BITRATE=160k
AUDIO_RATE=44100
# Seconds of silence between tracks
GAP_SECONDS=2
# Restart FFmpeg if it makes no progress for this many seconds
STALL_TIMEOUT=45
# Reconnect once a day at this hour (server time, at a track boundary); -1 = never
DAILY_RESTART_HOUR=4
# all | study | sleep | work
STREAM_SERIES=all
# Newest batch is this many times more likely to be picked
NEW_TRACK_WEIGHT=3
# Pin a specific loop video (normally leave unset)
#LOOP_FILE=
#
# ---- Library ----
# Number of weekly batches to keep, size cap, and free-disk floor
KEEP_BATCHES=8
LIBRARY_MAX_GB=15
MIN_FREE_GB=3
